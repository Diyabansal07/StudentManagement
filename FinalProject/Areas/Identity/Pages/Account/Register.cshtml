@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/EmptyLayout.cshtml";
}

<!DOCTYPE html>

<body>

    <div class="login-bg">

        <div class="login-wrapper">

            <!-- LEFT SIDE -->

            <div class="login-left">

                <img src="~/images/loginpage.jpg"
                     class="login-image" />

                <div class="overlay"></div>

                <div class="left-content">

                    <img src="~/images/logo.png"
                         class="logo" />

                    <h1>EduNova</h1>

                    <h3>
                        Create Your
                        <br />
                        Student Account
                    </h3>

                    <p>

                        Join EduNova and access student records,
                        academic performance tracking, attendance
                        management and institutional services
                        through one intelligent platform.

                    </p>

                </div>

            </div>

            <!-- RIGHT SIDE -->

            <div class="login-right">

                <div class="login-card">

                    <h2>Create Account</h2>

                    <p class="subtitle">

                        Register to continue

                    </p>

                    <form id="registerForm"
                          asp-route-returnUrl="@Model.ReturnUrl"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <!-- EMAIL -->

                        <div class="mb-4">

                            <label>Email Address</label>

                            <div class="input-box">

                                <i class="bi bi-envelope"></i>

                                <input asp-for="Input.Email"
                                       placeholder="Enter your email" />

                            </div>

                            <span asp-validation-for="Input.Email"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- PASSWORD -->

                        <div class="mb-4">

                            <label>Password</label>

                            <div class="input-box">

                                <i class="bi bi-lock"></i>

                                <input asp-for="Input.Password"
                                       type="password"
                                       placeholder="Create password" />

                            </div>

                            <span asp-validation-for="Input.Password"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- CONFIRM PASSWORD -->

                        <div class="mb-4">

                            <label>Confirm Password</label>

                            <div class="input-box">

                                <i class="bi bi-shield-lock"></i>

                                <input asp-for="Input.ConfirmPassword"
                                       type="password"
                                       placeholder="Confirm password" />

                            </div>

                            <span asp-validation-for="Input.ConfirmPassword"
                                  class="text-danger">
                            </span>

                        </div>

                        <button type="submit"
                                class="login-btn">

                            <i class="bi bi-person-plus"></i>

                            Create Account

                        </button>

                        <div class="divider">

                            OR

                        </div>

                        <a asp-page="./Login"
                           class="register-btn">

                            <i class="bi bi-box-arrow-in-right"></i>

                            Already Have An Account?

                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

    <partial name="_ValidationScriptsPartial" />

</body>

<style>

    html,
    body {
        margin: 0;
        height: 100%;
        font-family: 'Poppins',sans-serif;
    }

    body {
        background: #F4F2FF;
        overflow-x: hidden;
        overflow-y: auto;
    }

    /*======================
        BACKGROUND
        =======================*/

    .login-bg {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: radial-gradient(circle at top left,#8B5CF650,transparent 45%), radial-gradient(circle at bottom right,#7C3AED40,transparent 40%), #F8F7FF;
    }

    /*======================
        MAIN CARD
        =======================*/

    .login-wrapper {
        width: 100%;
        max-width: 1150px;
        min-height: 700px;
        background: white;
        border-radius: 30px;
        display: flex;
        overflow: hidden;
        box-shadow: 0 30px 80px rgba(91,61,245,.18);
    }

    /*======================
        LEFT
        =======================*/

    .login-left {
        flex: 0 0 45%;
        position: relative;
        overflow: hidden;
    }

    .login-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient( rgba(91,61,245,.75), rgba(124,58,237,.70) );
    }

    .left-content {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%,-50%);
        color: white;
        text-align: left;
        width: 80%;
        z-index: 10;
    }

    .logo {
        width: 75px;
        margin-bottom: 25px;
    }

    .left-content h1 {
        font-size: 52px;
        font-weight: 800;
        margin-bottom: 15px;
    }

    .left-content h3 {
        font-size: 34px;
        font-weight: 700;
        margin-bottom: 20px;
        line-height: 1.3;
    }

    .left-content p {
        font-size: 17px;
        line-height: 1.9;
        opacity: .95;
    }

    /*======================
        RIGHT
        =======================*/

    .login-right {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px;
        background: white;
    }

    .login-card {
        width: 430px;
    }

        .login-card h2 {
            font-size: 40px;
            font-weight: 700;
            color: #20263D;
            text-align: center;
        }

    .subtitle {
        color: #777;
        text-align: center;
        margin-bottom: 40px;
    }

    /*======================
        INPUTS
        =======================*/

    .input-box {
        display: flex;
        align-items: center;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 15px;
        padding: 14px 18px;
        transition: .3s;
    }

        .input-box:focus-within {
            border-color: #7C3AED;
            box-shadow: 0 0 0 .2rem rgba(124,58,237,.15);
        }

        .input-box i {
            color: #7C3AED;
            font-size: 20px;
            margin-right: 15px;
        }

        .input-box input {
            border: none;
            width: 100%;
            outline: none;
            background: none;
        }

    /*======================
        BUTTON
        =======================*/

    .login-btn {
        width: 100%;
        height: 55px;
        border: none;
        border-radius: 15px;
        color: white;
        font-size: 18px;
        font-weight: 600;
        background: linear-gradient(135deg,#5B3DF5,#8B5CF6);
        transition: .35s;
    }

        .login-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 18px 35px rgba(91,61,245,.35);
        }

    /*======================
        REGISTER
        =======================*/

    .divider {
        text-align: center;
        margin: 30px 0;
        color: #999;
        position: relative;
    }

        .divider::before,
        .divider::after {
            content: "";
            position: absolute;
            width: 42%;
            height: 1px;
            background: #ddd;
            top: 50%;
        }

        .divider::before {
            left: 0;
        }

        .divider::after {
            right: 0;
        }

    .register-btn {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        width: 100%;
        height: 55px;
        text-decoration: none;
        border-radius: 15px;
        border: 2px solid #7C3AED;
        color: #7C3AED;
        font-weight: 600;
        transition: .3s;
    }

        .register-btn:hover {
            background: #7C3AED;
            color: white;
        }
    /*=====================================
    TABLET
    ======================================*/

    @@media (max-width:991px) {

        .login-bg {
            padding: 20px;
        }

        .login-wrapper {
            flex-direction: column;
            max-width: 700px;
            min-height: auto;
        }

        .login-left {
            width: 100%;
            height: 260px;
        }

        .left-content h1 {
            font-size: 36px;
        }

        .left-content h3 {
            font-size: 24px;
        }

        .left-content p {
            font-size: 15px;
        }

        .login-right {
            width: 100%;
            padding: 40px 25px;
        }

        .login-card {
            width: 100%;
            max-width: 430px;
        }
    }


    /*=====================================
    IPHONE 12
    ======================================*/

    @@media (max-width:576px) {

        .login-bg {
            padding: 15px;
        }

        .login-wrapper {
            display: block;
            width: 100%;
            max-width: 420px;
            min-height: auto;
            border-radius: 20px;
        }
        /* Hide Image */

        .login-left {
            display: none;
        }

        .login-right {
            width: 100%;
            padding: 30px 22px;
        }

        .login-card {
            width: 100%;
            max-width: 100%;
        }

            .login-card h2 {
                font-size: 34px;
            }

        .subtitle {
            font-size: 15px;
            margin-bottom: 25px;
        }

        label {
            font-size: 15px;
            font-weight: 500;
        }

        .input-box {
            padding: 12px 15px;
            border-radius: 12px;
        }

            .input-box input {
                font-size: 15px;
            }

        .login-btn,
        .register-btn {
            height: 50px;
            font-size: 16px;
            border-radius: 12px;
        }

        .divider {
            margin: 20px 0;
        }
    }

</style>