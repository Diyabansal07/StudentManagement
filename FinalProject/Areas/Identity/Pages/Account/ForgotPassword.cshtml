@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/EmptyLayout.cshtml";
}

<!DOCTYPE html>



<body>

    <div class="forgot-bg">

        <div class="forgot-card">

            <div class="icon-circle">

                <i class="bi bi-shield-lock-fill"></i>

            </div>

            <h2>

                Forgot Password

            </h2>

            <p class="subtitle">

                Enter your registered email address.
                We'll allow you to reset your password.

            </p>

            <form method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-4">

                    <label>Email Address</label>

                    <div class="input-box">

                        <i class="bi bi-envelope"></i>

                        <input asp-for="Input.Email"
                               placeholder="Enter your email" />

                    </div>

                    <span asp-validation-for="Input.Email"
                          class="text-danger">
                    </span>

                </div>

                <button type="submit"
                        class="reset-btn">

                    <i class="bi bi-arrow-repeat"></i>

                    Reset Password

                </button>

                <div class="divider">

                    OR

                </div>

                <a asp-page="./Login"
                   class="back-btn">

                    <i class="bi bi-arrow-left"></i>

                    Back To Login

                </a>

            </form>

        </div>

    </div>

    @section Scripts{
        <partial name="_ValidationScriptsPartial" />
    }

</body>
<style>

    html,
    body {
        height: 100%;
        margin: 0;
        font-family: 'Poppins',sans-serif;
    }

    body {
        background: #F4F2FF;
        overflow-x: hidden;
        overflow-y: auto;
    }

    /*=========================
    BACKGROUND
    =========================*/

    .forgot-bg {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: radial-gradient(circle at top left,#8B5CF640,transparent 45%), radial-gradient(circle at bottom right,#7C3AED35,transparent 40%), #F8F7FF;
    }

    /*=========================
    CARD
    =========================*/

    .forgot-card {
        width: 100%;
        max-width: 480px;
        background: white;
        padding: 55px;
        border-radius: 28px;
        box-shadow: 0 30px 80px rgba(91,61,245,.15);
    }

    /*=========================
    ICON
    =========================*/

    .icon-circle {
        width: 90px;
        height: 90px;
        margin: auto;
        border-radius: 50%;
        background: linear-gradient(135deg,#5B3DF5,#8B5CF6);
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 25px;
    }

        .icon-circle i {
            color: white;
            font-size: 36px;
        }

    /*=========================
    TEXT
    =========================*/

    .forgot-card h2 {
        text-align: center;
        font-size: 38px;
        font-weight: 700;
        color: #20263D;
    }

    .subtitle {
        text-align: center;
        color: #777;
        line-height: 1.7;
        margin-bottom: 40px;
    }

    /*=========================
    INPUT
    =========================*/

    .input-box {
        display: flex;
        align-items: center;
        border: 1px solid #ddd;
        border-radius: 15px;
        padding: 15px 18px;
        transition: .3s;
    }

        .input-box:focus-within {
            border-color: #7C3AED;
            box-shadow: 0 0 0 .2rem rgba(124,58,237,.15);
        }

        .input-box i {
            color: #7C3AED;
            font-size: 20px;
            margin-right: 15px;
        }

        .input-box input {
            border: none;
            width: 100%;
            outline: none;
            background: none;
        }

    /*=========================
    BUTTON
    =========================*/

    .reset-btn {
        width: 100%;
        height: 56px;
        border: none;
        border-radius: 15px;
        background: linear-gradient(135deg,#5B3DF5,#8B5CF6);
        color: white;
        font-size: 18px;
        font-weight: 600;
        transition: .3s;
    }

        .reset-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 18px 35px rgba(91,61,245,.30);
        }

    /*=========================
    DIVIDER
    =========================*/

    .divider {
        margin: 30px 0;
        text-align: center;
        color: #999;
        position: relative;
    }

        .divider::before,
        .divider::after {
            content: "";
            position: absolute;
            width: 40%;
            height: 1px;
            background: #ddd;
            top: 50%;
        }

        .divider::before {
            left: 0;
        }

        .divider::after {
            right: 0;
        }

    /*=========================
    BACK BUTTON
    =========================*/

    .back-btn {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        width: 100%;
        height: 55px;
        border-radius: 15px;
        border: 2px solid #7C3AED;
        color: #7C3AED;
        font-weight: 600;
        transition: .3s;
    }

        .back-btn:hover {
            background: #7C3AED;
            color: white;
        }

    /*=========================
    ANIMATION
    =========================*/

    @@keyframes fadeUp {

        from {
            opacity: 0;
            transform: translateY(40px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /*=====================================
    TABLET
    ======================================*/

    @@media (max-width:768px) {

        .forgot-bg {
            padding: 25px;
        }

        .forgot-card {
            max-width: 500px;
            width: 100%;
            padding: 40px 35px;
        }

            .forgot-card h2 {
                font-size: 32px;
            }

        .subtitle {
            font-size: 15px;
        }
    }

    /*=====================================
    MOBILE
    ======================================*/

    @@media (max-width:576px) {

        .forgot-bg {
            padding: 18px;
        }

        .forgot-card {
            width: 100%;
            max-width: 420px;
            padding: 30px 22px;
            border-radius: 20px;
        }

        .icon-circle {
            width: 70px;
            height: 70px;
            margin-bottom: 20px;
        }

            .icon-circle i {
                font-size: 28px;
            }

        .forgot-card h2 {
            font-size: 30px;
        }

        .subtitle {
            font-size: 14px;
            margin-bottom: 28px;
        }

        label {
            font-size: 15px;
            font-weight: 500;
        }

        .input-box {
            padding: 12px 15px;
            border-radius: 12px;
        }

            .input-box input {
                font-size: 15px;
            }

            .input-box i {
                font-size: 18px;
            }

        .reset-btn,
        .back-btn {
            height: 50px;
            font-size: 16px;
            border-radius: 12px;
        }

        .divider {
            margin: 22px 0;
        }
    }

</style>