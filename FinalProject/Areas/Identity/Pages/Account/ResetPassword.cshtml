@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Views/Shared/EmptyLayout.cshtml";
}
<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Reset Password</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

</head>

<body>

    <div class="forgot-bg">

        <div class="forgot-card">

            <div class="logo-circle">

                <i class="bi bi-shield-lock-fill"></i>

            </div>

            <h2>Reset Password</h2>

            <p class="subtitle">

                Enter your new password below.

            </p>

            <form method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <input asp-for="Input.Code"
                       type="hidden" />

                <!-- Email -->

                <div class="mb-3">

                    <label>Email Address</label>

                    <div class="input-box">

                        <i class="bi bi-envelope"></i>

                        <input asp-for="Input.Email"
                               placeholder="Enter your email" />

                    </div>

                    <span asp-validation-for="Input.Email"
                          class="text-danger">
                    </span>

                </div>

                <!-- Password -->

                <div class="mb-3">

                    <label>New Password</label>

                    <div class="input-box">

                        <i class="bi bi-lock"></i>

                        <input asp-for="Input.Password"
                               type="password"
                               placeholder="New password" />

                    </div>

                    <span asp-validation-for="Input.Password"
                          class="text-danger">
                    </span>

                </div>

                <!-- Confirm -->

                <div class="mb-4">

                    <label>Confirm Password</label>

                    <div class="input-box">

                        <i class="bi bi-lock-fill"></i>

                        <input asp-for="Input.ConfirmPassword"
                               type="password"
                               placeholder="Confirm password" />

                    </div>

                    <span asp-validation-for="Input.ConfirmPassword"
                          class="text-danger">
                    </span>

                </div>

                <button type="submit"
                        class="reset-btn">

                    <i class="bi bi-check-circle me-2"></i>

                    Reset Password

                </button>

            </form>

        </div>

    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>

</html>
<style>

    html, body {
        height: 100%;
        margin: 0;
        font-family: 'Poppins',sans-serif;
    }

    body {
        background: #F7F5FF;
        overflow-x: hidden;
        overflow-y: auto;
    }

    .forgot-bg {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: radial-gradient(circle at top left,#8B5CF630,transparent 35%), radial-gradient(circle at bottom right,#7C3AED35,transparent 35%), #F7F5FF;
    }

    .forgot-card {
        width: 100%;
        max-width: 480px;
        background: white;
        border-radius: 28px;
        padding: 50px;
        box-shadow: 0 25px 60px rgba(91,61,245,.15);
    }

    .logo-circle {
        width: 85px;
        height: 85px;
        margin: auto;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg,#5B3DF5,#8B5CF6);
        color: white;
        font-size: 34px;
        margin-bottom: 25px;
    }

    h2 {
        text-align: center;
        font-weight: 700;
    }

    .subtitle {
        text-align: center;
        color: #777;
        margin-bottom: 35px;
    }

    .input-box {
        display: flex;
        align-items: center;
        border: 1px solid #ddd;
        border-radius: 14px;
        padding: 14px 18px;
    }

        .input-box i {
            color: #7C3AED;
            margin-right: 15px;
        }

        .input-box input {
            width: 100%;
            border: none;
            outline: none;
            background: none;
        }

        .input-box:focus-within {
            border-color: #7C3AED;
            box-shadow: 0 0 0 .2rem rgba(124,58,237,.15);
        }

    .reset-btn {
        width: 100%;
        height: 55px;
        border: none;
        border-radius: 15px;
        background: linear-gradient(135deg,#5B3DF5,#8B5CF6);
        color: white;
        font-size: 17px;
        font-weight: 600;
    }

        .reset-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(91,61,245,.25);
        }
    /*==========================================
    TABLET
    ==========================================*/

    @@media (max-width:768px) {

        .forgot-bg {
            padding: 25px;
        }

        .forgot-card {
            width: 100%;
            max-width: 500px;
            padding: 40px 35px;
        }

        h2 {
            font-size: 32px;
        }

        .subtitle {
            font-size: 15px;
        }
    }


    /*==========================================
    IPHONE 12
    ==========================================*/

    @@media (max-width:576px) {

        .forgot-bg {
            padding: 18px;
        }

        .forgot-card {
            width: 100%;
            max-width: 420px;
            padding: 30px 22px;
            border-radius: 20px;
        }

        .logo-circle {
            width: 70px;
            height: 70px;
            font-size: 28px;
            margin-bottom: 20px;
        }

        h2 {
            font-size: 30px;
        }

        .subtitle {
            font-size: 14px;
            margin-bottom: 28px;
        }

        label {
            font-size: 15px;
            font-weight: 500;
        }

        .input-box {
            padding: 12px 15px;
            border-radius: 12px;
        }

            .input-box input {
                font-size: 15px;
            }

            .input-box i {
                font-size: 18px;
            }

        .reset-btn {
            height: 50px;
            font-size: 16px;
            border-radius: 12px;
        }
    }
</style>