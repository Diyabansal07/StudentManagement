@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
     Layout = "~/Views/Shared/MyLayout.cshtml";
}

<div class="container-fluid py-4">

    <div class="row">

        <!-- Left Navigation -->
        <div class="col-lg-3 mb-4">

            <div class="card shadow-sm border-0 rounded-4">

                <div class="card-header border-0 text-white"
                     style="background:linear-gradient(135deg,#5B3DF5,#8B5CF6);">

                    <h5 class="mb-0">
                        <i class="bi bi-gear-fill me-2"></i>
                        Settings
                    </h5>

                </div>

                <div class="list-group list-group-flush">

                    <a <a asp-controller="Settings"
                          asp-action="Index"
                       class="list-group-item list-group-item-action">

                        <i class="bi bi-person-circle me-2"></i>

                        My Profile

                    </a>

                    <a asp-page="./ChangePassword"
                       class="list-group-item list-group-item-action active">

                        <i class="bi bi-shield-lock-fill me-2"></i>

                        Change Password

                    </a>

                </div>

            </div>

        </div>

        <!-- Right Content -->
        <div class="col-lg-9">

            <div class="card shadow border-0 rounded-4">

                <div class="card-header border-0 text-white"
                     style="background:linear-gradient(135deg,#5B3DF5,#8B5CF6);">

                    <h4 class="mb-0">

                        <i class="bi bi-lock-fill me-2"></i>

                        Change Password

                    </h4>

                </div>

                <div class="card-body p-4">

                    <p class="text-muted mb-4">
                        Update your account password securely.
                    </p>

                    <partial name="_StatusMessage" for="StatusMessage" />

                    <form method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label asp-for="Input.OldPassword"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Input.OldPassword"
                                   class="form-control form-control-lg" />

                            <span asp-validation-for="Input.OldPassword"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Input.NewPassword"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Input.NewPassword"
                                   class="form-control form-control-lg" />

                            <span asp-validation-for="Input.NewPassword"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Input.ConfirmPassword"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Input.ConfirmPassword"
                                   class="form-control form-control-lg" />

                            <span asp-validation-for="Input.ConfirmPassword"
                                  class="text-danger">
                            </span>

                        </div>

                        <button type="submit"
                                class="btn btn-lg text-white px-5"
                                style="background:linear-gradient(135deg,#5B3DF5,#8B5CF6);">

                            <i class="bi bi-check-circle-fill me-2"></i>

                            Update Password

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
<style>
    .setting-link {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: #555;
        padding: 14px 16px;
        border-radius: 14px;
        margin-bottom: 12px;
        transition: .3s;
        font-weight: 500;
    }

        .setting-link i {
            font-size: 20px;
        }

        .setting-link:hover {
            background: #F4EEFF;
            color: #6D28D9;
        }

        .setting-link.active {
            background: linear-gradient(135deg,#6D28D9,#8B5CF6);
            color: white;
            box-shadow: 0 10px 25px rgba(109,40,217,.25);
        }

    .text-purple {
        color: #6D28D9;
    }

    .btn-purple {
        background: linear-gradient(135deg,#6D28D9,#8B5CF6);
        color: white;
        border: none;
        border-radius: 12px;
    }

        .btn-purple:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 12px 25px rgba(109,40,217,.30);
        }

    .list-group-item {
        border: none;
        padding: 15px 20px;
        font-weight: 500;
        transition: .3s;
    }

        .list-group-item:hover {
            background: #f3ecff;
            color: #6f42c1;
        }

        .list-group-item.active {
            background: linear-gradient(135deg,#5B3DF5,#8B5CF6);
            border: none;
            color: #fff;
        }

    .form-control {
        border-radius: 12px;
    }

        .form-control:focus {
            border-color: #7C3AED;
            box-shadow: 0 0 0 .2rem rgba(124,58,237,.15);
        }

    .card {
        border-radius: 20px;
    }
</style>