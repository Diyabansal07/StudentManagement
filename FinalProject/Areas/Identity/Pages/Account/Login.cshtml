<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>EduNova Login</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

</head>

<body>

<div class="login-bg">

    <div class="login-wrapper">

        <!-- LEFT SIDE -->

        <div class="login-left">

            <img src="~/images/loginpage.jpg"
                 class="login-image"/>

            <div class="overlay"></div>

            <div class="left-content">

                <img src="~/images/logo.png"
                     class="logo"/>

                <h1>EduNova</h1>

                <h3>
                    Smart Student
                    <br>
                    Management System
                </h3>

                <p>

                    Simplify admissions, attendance,
                    academic records and performance
                    management with one intelligent platform.

                </p>

            </div>

        </div>

        <!-- RIGHT SIDE -->

        <div class="login-right">

            <div class="login-card">

                <h2>

                    Welcome Back

                </h2>

                <p class="subtitle">

                    Login to continue

                </p>

                <form method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <!-- EMAIL -->

                    <div class="mb-4">

                        <label>Email Address</label>

                        <div class="input-box">

                            <i class="bi bi-envelope"></i>

                            <input asp-for="Input.Email"
                                   placeholder="Enter your email"/>

                        </div>

                        <span asp-validation-for="Input.Email"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- PASSWORD -->

                    <div class="mb-4">

                        <label>Password</label>

                        <div class="input-box">

                            <i class="bi bi-lock"></i>

                            <input asp-for="Input.Password"
                                   type="password"
                                   placeholder="Enter your password"/>

                        </div>

                        <span asp-validation-for="Input.Password"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div>

                            <input asp-for="Input.RememberMe"/>

                            <label asp-for="Input.RememberMe">
                                Remember Me
                            </label>

                        </div>

                        <a asp-page="./ForgotPassword">

                            Forgot Password?

                        </a>

                    </div>

                    <button type="submit"
                            class="login-btn">

                        <i class="bi bi-box-arrow-in-right"></i>

                        Sign In

                    </button>

                    <div class="divider">

                        OR

                    </div>

                    <a asp-page="./Register"
                       class="register-btn">

                        <i class="bi bi-person-plus"></i>

                        Create New Account

                    </a>

                </form>

            </div>

        </div>

    </div>

</div>

    <partial name="_ValidationScriptsPartial" />
</body>

</html>

<style>

    html,
    body{

        margin:0;
        height:100%;
        font-family:'Poppins',sans-serif;

    }

    body{

        background:#F4F2FF;
        overflow:hidden;

    }

    /*======================
    BACKGROUND
    =======================*/

    .login-bg{

        min-height:100vh;

        display:flex;

        justify-content:center;

        align-items:center;

        background:

        radial-gradient(circle at top left,#8B5CF650,transparent 45%),

        radial-gradient(circle at bottom right,#7C3AED40,transparent 40%),

        #F8F7FF;

    }

    /*======================
    MAIN CARD
    =======================*/

    .login-wrapper{

        width:1150px;

        height:700px;

        background:white;

        border-radius:30px;

        overflow:hidden;

        display:flex;

        box-shadow:0 30px 80px rgba(91,61,245,.18);

    }

    /*======================
    LEFT
    =======================*/

    .login-left{

        width:45%;

        position:relative;

        overflow:hidden;

    }

    .login-image{

        width:100%;

        height:100%;

        object-fit:cover;

    }

    .overlay{

        position:absolute;

        inset:0;

        background:linear-gradient(

        rgba(91,61,245,.75),

        rgba(124,58,237,.70)

        );

    }

    .left-content{

        position:absolute;

        top:50%;

        left:50%;

        transform:translate(-50%,-50%);

        color:white;

        text-align:left;

        width:80%;

        z-index:10;

    }

    .logo{

        width:75px;

        margin-bottom:25px;

    }

    .left-content h1{

        font-size:52px;

        font-weight:800;

        margin-bottom:15px;

    }

    .left-content h3{

        font-size:34px;

        font-weight:700;

        margin-bottom:20px;

        line-height:1.3;

    }

    .left-content p{

        font-size:17px;

        line-height:1.9;

        opacity:.95;

    }

    /*======================
    RIGHT
    =======================*/

    .login-right{

        width:55%;

        display:flex;

        justify-content:center;

        align-items:center;

        background:white;

    }

    .login-card{

        width:430px;

    }

    .login-card h2{

        font-size:40px;

        font-weight:700;

        color:#20263D;

        text-align:center;

    }

    .subtitle{

        color:#777;

        text-align:center;

        margin-bottom:40px;

    }

    /*======================
    INPUTS
    =======================*/

    .input-box{

        display:flex;

        align-items:center;

        background:#fff;

        border:1px solid #ddd;

        border-radius:15px;

        padding:14px 18px;

        transition:.3s;

    }

    .input-box:focus-within{

        border-color:#7C3AED;

        box-shadow:0 0 0 .2rem rgba(124,58,237,.15);

    }

    .input-box i{

        color:#7C3AED;

        font-size:20px;

        margin-right:15px;

    }

    .input-box input{

        border:none;

        width:100%;

        outline:none;

        background:none;

    }

    /*======================
    BUTTON
    =======================*/

    .login-btn{

        width:100%;

        height:55px;

        border:none;

        border-radius:15px;

        color:white;

        font-size:18px;

        font-weight:600;

        background:linear-gradient(135deg,#5B3DF5,#8B5CF6);

        transition:.35s;

    }

    .login-btn:hover{

        transform:translateY(-3px);

        box-shadow:0 18px 35px rgba(91,61,245,.35);

    }

    /*======================
    REGISTER
    =======================*/

    .divider{

        text-align:center;

        margin:30px 0;

        color:#999;

        position:relative;

    }

    .divider::before,

    .divider::after{

        content:"";

        position:absolute;

        width:42%;

        height:1px;

        background:#ddd;

        top:50%;

    }

    .divider::before{

        left:0;

    }

    .divider::after{

        right:0;

    }

    .register-btn{

        display:flex;

        justify-content:center;

        align-items:center;

        gap:10px;

        width:100%;

        height:55px;

        text-decoration:none;

        border-radius:15px;

        border:2px solid #7C3AED;

        color:#7C3AED;

        font-weight:600;

        transition:.3s;

    }

    .register-btn:hover{

        background:#7C3AED;

        color:white;

    }

    /*======================
    RESPONSIVE
    =======================*/

    @@media (max - width:991px){

    .login-wrapper{

        flex-direction:column;

        width:95%;
        height:auto;

    }

    .login-left{

        height:320px;
        width:100%;

    }

    .login-right{

        width:100%;
        padding:50px 25px;

    }

    .login-card{

        width:100%;

    }

    }

</style>