<style>
    /* ==========================================
    TABLET
    ========================================== */

    @@media (max-width:991px) {

    .navbar {
    padding: 15px 0;
    }

    .navbar-brand h5 {
    font-size: 22px;
    }

    .hero-section {
    padding: 120px 0 80px;
    text-align: center;
    padding-bottom: 90px;
    }

    .hero-title {
    font-size: 46px;
    }

    .hero-description {
    font-size: 17px;
    }

    .hero-buttons {
    justify-content: center;
    gap: 15px !important;
    }

    .section-title h2 {
    font-size: 34px;
    }

    .feature-card,
    .module-card,
    .stat-card {
    margin-bottom: 20px;
    }

    .footer-dark {
    text-align: center;
    }

    .social-icons {
    justify-content: center;
    }
    }

    /* ==========================================
    MOBILE (iPhone 12)
    ========================================== */

    @@media (max-width:576px) {

    .navbar {
    padding: 12px 0;
    }

    .navbar-brand img {
    width: 40px;
    }

    .navbar-brand h5 {
    font-size: 20px;
    }

    .navbar-brand small {
    font-size: 12px;
    }

    .hero-section {
    padding-top: 110px;
    padding-bottom: 70px;
    }

    .hero-title {
    font-size: 34px;
    line-height: 1.3;
    }

    .hero-description {
    font-size: 15px;
    }

    .hero-tag {
    font-size: 13px;
    }

    .hero-buttons .btn {
    width: 85%;
    max-width: 260px;
    margin: 0 auto;
    display: block;
    }

    .section-title h2 {
    font-size: 28px;
    }

    .section-description {
    font-size: 15px;
    }

    .feature-card,
    .module-card,
    .stat-card {
    padding: 25px;
    }

    .stat-card h2 {
    font-size: 30px;
    }

    .footer-dark {
    text-align: center;
    padding: 60px 0;
    }

    .footer-links {
    padding-left: 0;
    list-style: none;
    }

    .footer-links li {
    margin-bottom: 10px;
    }

    .social-icons {
    justify-content: center;
    }
    .stat-card {
    padding: 20px 15px;
    border-radius: 20px;
    height: 190px;
    }

    .stat-circle {
    width: 65px;
    height: 65px;
    margin: 0 auto 15px;
    }

    .stat-circle i {
    font-size: 24px;
    }

    .stat-card h2 {
    font-size: 30px;
    margin-bottom: 8px;
    }

    .stat-card p {
    font-size: 15px;
    }
    }
</style>
