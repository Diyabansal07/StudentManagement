                    <div class="stat-circle">

                        <i class="bi bi-people-fill"></i>

                    </div>

                        <h2>50+</h2>

                        <p>Courses Offered</p>

                    </div>

                </div>

                <div class="col-6 col-md-6 col-lg-3">

                    <div class="stat-card">

                    <div class="stat-circle">

                        <i class="bi bi-people-fill"></i>

                    </div>

                        <h2>80+</h2>

