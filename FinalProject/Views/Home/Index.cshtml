                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse" id="menu">

                <ul class="navbar-nav mx-auto">

                    <li class="nav-item">
                        <a class="nav-link active" href="#home">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#about">
                            About
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#features">
                            Features
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#modules">
                            Modules
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#contact">
                            Contact
                        </a>
                    </li>

                </ul>

           

                <div class="d-flex flex-column flex-lg-row gap-2 mt-3 mt-lg-0">

                      <a asp-area="Identity"
                        asp-page="/Account/Login"
                         class="btn btn-outline-purple">

                          Login

                      </a>

                      <a asp-area="Identity"
                         asp-page="/Account/Register"
                         class="btn btn-purple">
       
                          Register

                      </a>

                </div>
            </div>
        </div>

        </div>

    </nav>

    <!-- ========================= -->
    <!-- HERO -->
    <!-- ========================= -->
<section id="home" class="hero-section">

    <div class="hero-overlay"></div>

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-6 hero-content text-center text-lg-start">

                <span class="hero-tag">
                    Modern Education Platform
                </span>

                <h1 class="hero-title">---------

                    Smart Education

                    <span>Management</span>

                    Platform

                </h1>

                <p class="hero-description">

                    EduNova is a comprehensive Student Management System for
                    schools, colleges and universities. Manage admissions,
                    students, courses and academic performance from one place.

                </p>

                <div class="hero-buttons d-flex flex-column flex-sm-row justify-content-center justify-content-lg-start gap-3">

                    <a asp-area="Identity"
                       asp-page="/Account/Login"
                       class="btn hero-btn-primary">

                        Get Started

                    </a>

                    <a asp-area="Identity"
                       asp-page="/Account/Register"
                       class="btn hero-btn-outline">

                        Create Account

                    </a>

                </div>

            </div>

            <div class="col-lg-6">
            </div>

        </div>

    </div>

</section>


    <!-- ===================== -->
    <!-- WHY EDUNOVA -->
    <!-- ===================== -->

    <section id="about" class="about-section">

        <div class="container">

          <div class="section-title text-center px-3">

                <span>WHY CHOOSE EDUNOVA</span>

                <h2>
                    Everything Your Institution Needs
                    <br />
                    In One Platform
                </h2>

            <p class="section-description">

                EduNova is a modern Student Management System designed to simplify
                the complete academic workflow for schools, colleges and universities.

                From student admissions and profile management to course allocation,
                attendance tracking, examination records and performance analytics,
                EduNova provides one centralized platform for every academic operation.

                Built using ASP.NET Core MVC with SQL Server, the system offers
                secure authentication, responsive dashboards, real-time reporting,
                and an intuitive user experience that helps institutions improve
                efficiency, reduce paperwork and make smarter academic decisions.

            </p>

          </div>
    </section>

    <section id="features" class="features-section">

      <div class="container">

        <div class="row g-4 justify-content-center mt-5 px-lg-4">

                <div class="col-lg-4">

                <div class="feature-card">

                      <div class="feature-icon">

                        <i class="bi bi-mortarboard-fill"></i>

                      </div>

                       <h3>Student Management</h3>

                       <p>

                        Manage admissions, personal details,
                        academic records and complete student profiles.

                       </p>

                  </div>

                </div>

        
                <div class="col-lg-4">

                    <div class="feature-card">

                        <div class="feature-icon">
                        <i class="bi bi-mortarboard-fill"></i>
                        </div>

                        <h4>Course Management</h4>

                        <p>
                            Organize departments,
                            courses,
                            credits,
                            semesters and faculty
                            using one simple interface.
                        </p>

                    </div>

                </div>


                <div class="col-lg-4">

                    <div class="feature-card">

                        <div class="feature-icon">
                        <i class="bi bi-mortarboard-fill"></i>
                        </div>

                        <h4>Performance Reports</h4>

                        <p>
                            Monitor attendance,
                            marks,
                            grades and student performance
                            using analytical reports.
                        </p>

                    </div>

                </div>

            </div>

       </div>

    </section>

