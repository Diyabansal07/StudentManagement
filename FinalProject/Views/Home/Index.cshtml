                    <div class="stat-circle">

                        <i class="bi bi-people-fill"></i>

                    </div>

                        <h2>50+</h2>

                        <p>Courses Offered</p>

                    </div>

                </div>

                <div class="col-lg-3 col-md-6">

                    <div class="stat-card">

                    <div class="stat-circle">

                        <i class="bi bi-people-fill"></i>

                    </div>

