                    </div>

                </div>

                <div class="col-6 col-md-6 col-lg-3">

                    <div class="stat-card">

                    <div class="stat-circle">

                        <i class="bi bi-people-fill"></i>

                    </div>

                        <h2>98%</h2>

                        <p>Academic Success</p>

                    </div>

                </div>

            </div>

        </div>

    </section>
    <!-- ======================================= -->
    <!-- OUR MODULES -->
    <!-- ======================================= -->

    <section id="modules" class="modules-section">

        <div class="container">

            <div class="section-title mb-5">

                <span>OUR MODULES</span>

                <h2>Powerful Features Designed For Educational Institutions</h2>

                <p>
                    EduNova provides all the essential modules required to efficiently
                    manage students, courses, academic records and institutional data
                    through one centralized platform.
                </p>

            </div>

            <div class="row g-4">

                <!-- Student -->

                <div class="col-lg-4 col-md-6">

                    <div class="module-card">
                    

                        <div class="module-icon bg-purple-light">

                            <i class="bi bi-people-fill"></i>

                        </div>

                        <h4>Student Management</h4>

                        <p>

                            Register, update, delete and maintain complete student
                            information with validation and secure record management.

                        </p>

                    </div>

                </div>

                <!-- Courses -->

                <div class="col-lg-4 col-md-6">

                    <div class="module-card">

                        <div class="module-icon bg-purple-light">

                            <i class="bi bi-journal-bookmark-fill"></i>

                        </div>

                        <h4>Course Management</h4>

                        <p>

                            Organize departments, courses, semesters and academic
                            programs through an intuitive interface.

                        </p>

                    </div>

                </div>

                <!-- Reports -->

                <div class="col-lg-4 col-md-6">

                    <div class="module-card">
                     

                        <div class="module-icon bg-purple-light">

                            <i class="bi bi-bar-chart-fill"></i>

                        </div>

                        <h4>Performance Reports</h4>

                        <p>

                            Generate insightful reports for academic performance,
                            student records and institutional statistics.

                        </p>

                    </div>

                </div>

                <!-- Secure -->

                <div class="col-lg-4 col-md-6">

                    <div class="module-card">
                     

                        <div class="module-icon bg-purple-light">

                            <i class="bi bi-shield-lock-fill"></i>

                        </div>

                        <h4>Secure Authentication</h4>

                        <p>

                            ASP.NET Identity authentication ensures safe access
                            to institutional data and user accounts.

                        </p>

                    </div>

                </div>

                <!-- Dashboard -->

                <div class="col-lg-4 col-md-6">

                    <div class="module-card">
                     

                        <div class="module-icon bg-purple-light">

                            <i class="bi bi-speedometer2"></i>

                        </div>

                        <h4>Interactive Dashboard</h4>

                        <p>

                            Access institutional information through a responsive,
                            modern dashboard with real-time statistics.

                        </p>

                    </div>

                </div>

                <!-- Database -->

                <div class="col-lg-4 col-md-6">

                    <div class="module-card">
                     

                        <div class="module-icon bg-purple-light">

                            <i class="bi bi-database-fill"></i>

                        </div>

                        <h4>Centralized Database</h4>

                        <p>

                            Store and manage all institutional records securely
                            using Microsoft SQL Server and Entity Framework Core.

                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>
