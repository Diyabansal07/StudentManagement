@model IEnumerable<Student>

@{
    Layout = "~/Views/Shared/MyLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap student-card-header mb-4">

        <div>
            <h2 class="text-purple fw-bold mb-1">
                <i class="bi bi-people-fill me-2"></i>
                Student Management
            </h2>

            <p class="text-muted mb-0">
                Manage all registered students.
            </p>
        </div>

        <button type="button"
                class="btn btn-purple add-student-btn"
                data-bs-toggle="modal"
                data-bs-target="#courseWarningModal">

            <i class="bi bi-plus-circle me-2"></i>
            Add Student

        </button>

    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["success"]

            <button class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <!-- Card -->

    <div class="card shadow">

        <div class="card-header card-header-purple py-3">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <!-- Heading -->
                <h5 class="text-white fw-semibold mb-0">
                    <i class="bi bi-people-fill me-2"></i>
                    Student List
                </h5>

                <!-- Search + Filter -->
                <div class="d-flex flex-column flex-md-row align-items-stretch align-items-md-center gap-2 w-100 w-md-auto">

                    <!-- Search -->
                    <div class="position-relative search-box">

                        <i class="bi bi-search position-absolute"
                           style="left:15px; top:50%; transform:translateY(-50%);
                        color:#6c757d; z-index:5;"></i>

                        <input type="search"
                               id="searchStudent"
                               class="form-control rounded-pill ps-5"
                               placeholder="Search Student..." />

                    </div>

                    <!-- Filter -->
                    <div class="dropdown">

                        <button class="btn btn-light rounded-pill px-3 w-100"
                                type="button"
                                data-bs-toggle="dropdown">

                            <i class="bi bi-funnel-fill me-1"></i>
                            Filter

                        </button>

                        <ul class="dropdown-menu dropdown-menu-end shadow">

                            <li>
                                <a class="dropdown-item student-filter active"
                                   href="#"
                                   data-status="All">

                                    <i class="bi bi-list me-2"></i>
                                    All Students

                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item student-filter"
                                   href="#"
                                   data-status="Active">

                                    <i class="bi bi-check-circle-fill text-success me-2"></i>
                                    Active

                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item student-filter"
                                   href="#"
                                   data-status="Inactive">

                                    <i class="bi bi-x-circle-fill text-danger me-2"></i>
                                    Inactive

                                </a>
                            </li>

                        </ul>

                    </div>

                </div>

            </div>

        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle"
                       id="studentTable">

                    <thead>

                        <tr>

                            <th>ID</th>
                            <th>Name</th>
                            <th>Department</th>
                            <th>Course</th>
                            <th>Status</th>
                            <th width="180">Actions</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @item.StudentId
                                </td>

                                <td>
                                    @item.FirstName @item.LastName
                                </td>

                                <td>
                                    @item.Department
                                </td>

                                <td>
                                    @item.Course?.CourseName
                                </td>

                                <td>

                                    @if (item.Status == "Active")
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Inactive
                                        </span>
                                    }

                                </td>

                                <td>
                                   <div class="action-buttons">
                                    <!-- VIEW -->

                                    <button type="button"
                                            class="btn btn-sm btn-outline-info viewStudent"
                                            data-bs-toggle="modal"
                                            data-bs-target="#viewStudentModal"
                                            data-id="@item.StudentId"
                                            data-name="@($"{item.FirstName} {item.LastName}")"
                                            data-email="@item.Email"
                                            data-phone="@item.PhoneNumber"
                                            data-gender="@item.Gender"
                                            data-department="@item.Department"
                                            data-course="@(item.Course?.CourseName ?? "N/A")"
                                            data-status="@item.Status"
                                            data-admission="@(item.AdmissionDate?.ToString("dd MMM yyyy"))">

                                        <i class="bi bi-eye-fill"></i>

                                    </button>

                                    <!-- EDIT -->

                                    <a asp-action="Upsert"
                                       asp-route-id="@item.StudentId"
                                       class="btn btn-sm btn-outline-primary">

                                        <i class="bi bi-pencil-square"></i>

                                    </a>

                                    <!-- DELETE -->

                                    <a href="#"
                                       class="btn btn-sm btn-outline-danger"
                                       data-bs-toggle="modal"
                                       data-bs-target="#deleteModal"
                                       data-id="@item.StudentId">

                                        <i class="bi bi-trash"></i>

                                    </a>
                                  </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
<div class="modal fade"
     id="viewStudentModal"
     tabindex="-1">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content border-0 shadow-lg">

            <div class="modal-header"
                 style="background:linear-gradient(135deg,#6D28D9,#8B5CF6);color:white;">

                <h5 class="modal-title">

                    <i class="bi bi-person-badge-fill me-2"></i>

                    Student Details

                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body p-4">

                <div class="row g-4">

                    <div class="col-md-6">

                        <label class="fw-bold text-muted">
                            Student ID
                        </label>

                        <div id="viewId" class="detail-box"></div>

                    </div>

                    <div class="col-md-6">

                        <label class="fw-bold text-muted">
                            Name
                        </label>

                        <div id="viewName" class="detail-box"></div>

                    </div>

                    <div class="col-md-6">

                        <label class="fw-bold text-muted">
                            Email
                        </label>

                        <div id="viewEmail" class="detail-box"></div>

                    </div>

                    <div class="col-md-6">

                        <label class="fw-bold text-muted">
                            Phone
                        </label>

                        <div id="viewPhone" class="detail-box"></div>

                    </div>

                    <div class="col-md-6">

                        <label class="fw-bold text-muted">
                            Gender
                        </label>

                        <div id="viewGender" class="detail-box"></div>

                    </div>

                    <div class="col-md-6">

                        <label class="fw-bold text-muted">
                            Department
                        </label>

                        <div id="viewDepartment" class="detail-box"></div>

                    </div>

                    <div class="col-md-6">

                        <label class="fw-bold text-muted">
                            Course
                        </label>

                        <div id="viewCourse" class="detail-box"></div>

                    </div>

                    <div class="col-md-6">

                        <label class="fw-bold text-muted">
                            Status
                        </label>

                        <div id="viewStatus" class="detail-box"></div>

                    </div>

                    <div class="col-md-12">

                        <label class="fw-bold text-muted">
                            Admission Date
                        </label>

                        <div id="viewAdmission" class="detail-box"></div>

                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button class="btn btn-purple"
                        data-bs-dismiss="modal">

                    Close

                </button>

            </div>

        </div>

    </div>

</div>
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <form asp-action="Delete" method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">Delete Student</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <input type="hidden" id="StudentId" name="StudentId" />

                    <p>Are you sure you want to delete this student?</p>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-danger">
                        Delete
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>
<!-- Course Warning Modal -->

<div class="modal fade"
     id="courseWarningModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0">

            <div class="modal-header bg-warning text-dark">

                <h5 class="modal-title">

                    <i class="bi bi-exclamation-triangle-fill me-2"></i>

                    Before Adding a Student

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <div class="alert alert-warning mb-0">

                    <strong>Important!</strong>

                    <br /><br />

                    Please ensure that the student's
                    <strong>Course</strong> has already been added in the
                    <strong>Course Management</strong> section.

                    <br /><br />

                    Only courses already available in the system will appear
                    in the Course dropdown during Student Registration.

                </div>

            </div>

            <div class="modal-footer">

                <button class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Cancel

                </button>

                <a asp-controller="Student"
                   asp-action="Upsert"
                   class="btn btn-purple">

                    Continue

                </a>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

     const searchInput = document.getElementById("searchStudent");

        let selectedStatus = "All";

        function filterStudentTable() {

            const search = searchInput.value.toLowerCase();

            const rows = document.querySelectorAll("#studentTable tbody tr");

            rows.forEach(function(row){

                const rowText = row.innerText.toLowerCase();

                const rowStatus =
                    row.cells[4].innerText.trim();

                const searchMatch =
                    rowText.includes(search);

                const statusMatch =
                    selectedStatus === "All" ||
                    rowStatus === selectedStatus;

                row.style.display =
                    (searchMatch && statusMatch)
                    ? ""
                    : "none";

            });

        }

        searchInput.addEventListener(
            "keyup",
            filterStudentTable
        );

        document
        .querySelectorAll(".student-filter")
        .forEach(function(item){

            item.addEventListener("click", function(e){

                e.preventDefault();

                selectedStatus =
                    this.dataset.status;

                document
                .querySelectorAll(".student-filter")
                .forEach(x =>
                    x.classList.remove("active")
                );

                this.classList.add("active");

                filterStudentTable();

            });

        });
                document.querySelectorAll(".viewStudent").forEach(function (btn) {

            btn.addEventListener("click", function () {

                document.getElementById("viewId").innerHTML =
                    this.dataset.id;

                document.getElementById("viewName").innerHTML =
                    this.dataset.name;

                document.getElementById("viewEmail").innerHTML =
                    this.dataset.email;

                document.getElementById("viewPhone").innerHTML =
                    this.dataset.phone;

                document.getElementById("viewGender").innerHTML =
                    this.dataset.gender;

                document.getElementById("viewDepartment").innerHTML =
                    this.dataset.department;

                document.getElementById("viewCourse").innerHTML =
                    this.dataset.course;

                document.getElementById("viewStatus").innerHTML =
                    this.dataset.status;

                document.getElementById("viewAdmission").innerHTML =
                    this.dataset.admission;

            });

        });
        
        var deleteModal = document.getElementById('deleteModal');

        deleteModal.addEventListener('show.bs.modal', function (event) {

            var button = event.relatedTarget;

            document.getElementById('StudentId').value =
                button.getAttribute('data-id');
        });


    </script>

}
<style>

    .detail-box {
        background: #F8F5FF;
        border-left: 4px solid #7C3AED;
        border-radius: 12px;
        padding: 14px 18px;
        font-weight: 600;
        color: #374151;
        min-height: 52px;
        display: flex;
        align-items: center;
    }

    .modal-content {
        border-radius: 22px;
    }

    .modal-header {
        border: none;
    }

    .modal-footer {
        border: none;
    }

    .viewStudent {
        transition: .3s;
    }

        .viewStudent:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 18px rgba(124,58,237,.25);
        }

    .add-student-btn {
        width: auto;
    }

    .card-header h5 {
        margin-bottom: 0;
    }
    @@media (max-width:767.98px) {

        .add-student-btn {
            width: 100%;
        }

        .card {
            border-radius: 18px;
        }

        .card-body {
            padding: 1rem;
        }

        .container-fluid {
            padding-left: 12px;
            padding-right: 12px;
        }
    }
    /* ==========================================
       STUDENT PAGE RESPONSIVE
    ========================================== */

    .search-box {
        width: 340px;
    }
    @@media (min-width:992px) {

        .search-box {
            width: 340px;
            flex-shrink: 0;
        }
    }

    .action-buttons {
        display: flex;
        gap: 6px;
    }
    .action-buttons .btn {
        margin: 2px;
    }

    .student-card-header {
        flex-direction: row;
    }

    @@media (max-width:991.98px) {

        .search-box {
            width: 100%;
            max-width: 100%;
        }

 

        .student-card-header {
            flex-direction: column;
            align-items: stretch !important;
            gap: 15px;
        }
    
          .card-header .d-flex {
             gap: 15px;
          }

            .card-header h5 {
             text-align: center;
             margin-bottom: 0;
             }
        
            .table-responsive::-webkit-scrollbar {
                height: 4px;
            }

            .table-responsive::-webkit-scrollbar-thumb {
                background: #c9c9c9;
                border-radius: 10px;
            }

        .modal-dialog {
            margin: 1rem;
        }

        .app-main {
            min-height: calc(100vh - 120px);
        }
        .card-header .d-flex > div:last-child {
            width: 100%;
        }

        .dropdown {
            margin-left: 8px;
        }
    }

    @@media (max-width:767.98px) {

        h2 {
            font-size: 26px;
        }

        .add-student-btn {
            width: 100%;
        }

        .table th,
        .table td {
            white-space: nowrap;
            font-size: 14px;
        }

        .action-buttons {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 6px;
        }

            .action-buttons .btn {
                width: 36px;
                height: 36px;
                padding: 0;
                display: inline-flex;
                justify-content: center;
                align-items: center;
            }

        .modal-dialog {
            margin: .6rem;
        }

        .detail-box {
            font-size: 14px;
            padding: 12px;
        }
    }

    #courseWarningModal .modal-dialog {
        margin: 1.75rem auto;
    }

    @@media (max-width:768px) {
        #courseWarningModal .modal-dialog {
            margin: .75rem;
        }
    }

</style>
