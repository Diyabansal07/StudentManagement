@model IEnumerable<Student>

@{
    Layout = "~/Views/Shared/MyLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="text-purple fw-bold mb-1">
                <i class="bi bi-people-fill me-2"></i>
                Student Management
            </h2>

            <p class="text-muted mb-0">
                Manage all registered students.
            </p>
        </div>

        <a asp-controller="Student"
           asp-action="Upsert"
           class="btn btn-purple">

            <i class="bi bi-plus-circle me-2"></i>
            Add Student

        </a>

    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["success"]

            <button class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <!-- Card -->

    <div class="card shadow">

        <div class="card-header card-header-purple py-3">

            <div class="d-flex justify-content-between align-items-center flex-wrap">

                <!-- Heading -->
                <h5 class="text-white fw-semibold mb-0">
                    <i class="bi bi-people-fill me-2"></i>
                    Student List
                </h5>

                <!-- Search + Filter -->
                <div class="d-flex align-items-center gap-2">

                    <!-- Search -->
                    <div class="position-relative" style="width:340px;">

                        <i class="bi bi-search position-absolute"
                           style="left:15px; top:50%; transform:translateY(-50%);
                        color:#6c757d; z-index:5;"></i>

                        <input type="search"
                               id="searchStudent"
                               class="form-control rounded-pill ps-5"
                               placeholder="Search Student..." />

                    </div>

                    <!-- Filter -->
                    <div class="dropdown">

                        <button class="btn btn-light rounded-pill px-3"
                                type="button"
                                data-bs-toggle="dropdown">

                            <i class="bi bi-funnel-fill me-1"></i>
                            Filter

                        </button>

                        <ul class="dropdown-menu dropdown-menu-end shadow">

                            <li>
                                <a class="dropdown-item student-filter active"
                                   href="#"
                                   data-status="All">

                                    <i class="bi bi-list me-2"></i>
                                    All Students

                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item student-filter"
                                   href="#"
                                   data-status="Active">

                                    <i class="bi bi-check-circle-fill text-success me-2"></i>
                                    Active

                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item student-filter"
                                   href="#"
                                   data-status="Inactive">

                                    <i class="bi bi-x-circle-fill text-danger me-2"></i>
                                    Inactive

                                </a>
                            </li>

                        </ul>

                    </div>

                </div>

            </div>

        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle"
                       id="studentTable">

                    <thead>

                        <tr>

                            <th>ID</th>
                            <th>Name</th>
                            <th>Department</th>
                            <th>Course</th>
                            <th>Status</th>
                            <th width="180">Actions</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @item.StudentId
                                </td>

                                <td>
                                    @item.FirstName @item.LastName
                                </td>

                                <td>
                                    @item.Department
                                </td>

                                <td>
                                    @item.Course?.CourseName
                                </td>

                                <td>

                                    @if (item.Status == "Active")
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Inactive
                                        </span>
                                    }

                                </td>

                                <td>

                                    <!-- VIEW -->

                                    <button type="button"
                                            class="btn btn-sm btn-outline-info viewStudent"
                                            data-bs-toggle="modal"
                                            data-bs-target="#viewStudentModal"
                                            data-id="@item.StudentId"
                                            data-name="@($"{item.FirstName} {item.LastName}")"
                                            data-email="@item.Email"
                                            data-phone="@item.PhoneNumber"
                                            data-gender="@item.Gender"
                                            data-department="@item.Department"
                                            data-course="@(item.Course?.CourseName ?? "N/A")"
                                            data-status="@item.Status"
                                            data-admission="@(item.AdmissionDate?.ToString("dd MMM yyyy"))">

                                        <i class="bi bi-eye-fill"></i>

                                    </button>

                                    <!-- EDIT -->

                                    <a asp-action="Upsert"
                                       asp-route-id="@item.StudentId"
                                       class="btn btn-sm btn-outline-primary">

                                        <i class="bi bi-pencil-square"></i>

                                    </a>

                                    <!-- DELETE -->

                                    <a href="#"
                                       class="btn btn-sm btn-outline-danger"
                                       data-bs-toggle="modal"
                                       data-bs-target="#deleteModal"
                                       data-id="@item.StudentId">

                                        <i class="bi bi-trash"></i>

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
<div class="modal fade"
     id="viewStudentModal"
     tabindex="-1">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content border-0 shadow-lg">

            <div class="modal-header"
                 style="background:linear-gradient(135deg,#6D28D9,#8B5CF6);color:white;">

                <h5 class="modal-title">

                    <i class="bi bi-person-badge-fill me-2"></i>

                    Student Details

                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body p-4">

                <div class="row g-4">

                    <div class="col-md-6">

                        <label class="fw-bold text-muted">
                            Student ID
                        </label>

                        <div id="viewId" class="detail-box"></div>

                    </div>

                    <div class="col-md-6">

                        <label class="fw-bold text-muted">
                            Name
                        </label>

                        <div id="viewName" class="detail-box"></div>

                    </div>

                    <div class="col-md-6">

                        <label class="fw-bold text-muted">
                            Email
                        </label>

                        <div id="viewEmail" class="detail-box"></div>

                    </div>

                    <div class="col-md-6">

                        <label class="fw-bold text-muted">
                            Phone
                        </label>

                        <div id="viewPhone" class="detail-box"></div>

                    </div>

                    <div class="col-md-6">

                        <label class="fw-bold text-muted">
                            Gender
                        </label>

                        <div id="viewGender" class="detail-box"></div>

                    </div>

                    <div class="col-md-6">

                        <label class="fw-bold text-muted">
                            Department
                        </label>

                        <div id="viewDepartment" class="detail-box"></div>

                    </div>

                    <div class="col-md-6">

                        <label class="fw-bold text-muted">
                            Course
                        </label>

                        <div id="viewCourse" class="detail-box"></div>

                    </div>

                    <div class="col-md-6">

                        <label class="fw-bold text-muted">
                            Status
                        </label>

                        <div id="viewStatus" class="detail-box"></div>

                    </div>

                    <div class="col-md-12">

                        <label class="fw-bold text-muted">
                            Admission Date
                        </label>

                        <div id="viewAdmission" class="detail-box"></div>

                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button class="btn btn-purple"
                        data-bs-dismiss="modal">

                    Close

                </button>

            </div>

        </div>

    </div>

</div>
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <form asp-action="Delete" method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">Delete Student</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <input type="hidden" id="StudentId" name="StudentId" />

                    <p>Are you sure you want to delete this student?</p>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-danger">
                        Delete
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {

    <script>

     const searchInput = document.getElementById("searchStudent");

        let selectedStatus = "All";

        function filterStudentTable() {

            const search = searchInput.value.toLowerCase();

            const rows = document.querySelectorAll("#studentTable tbody tr");

            rows.forEach(function(row){

                const rowText = row.innerText.toLowerCase();

                const rowStatus =
                    row.cells[4].innerText.trim();

                const searchMatch =
                    rowText.includes(search);

                const statusMatch =
                    selectedStatus === "All" ||
                    rowStatus === selectedStatus;

                row.style.display =
                    (searchMatch && statusMatch)
                    ? ""
                    : "none";

            });

        }

        searchInput.addEventListener(
            "keyup",
            filterStudentTable
        );

        document
        .querySelectorAll(".student-filter")
        .forEach(function(item){

            item.addEventListener("click", function(e){

                e.preventDefault();

                selectedStatus =
                    this.dataset.status;

                document
                .querySelectorAll(".student-filter")
                .forEach(x =>
                    x.classList.remove("active")
                );

                this.classList.add("active");

                filterStudentTable();

            });

        });
                document.querySelectorAll(".viewStudent").forEach(function (btn) {

            btn.addEventListener("click", function () {

                document.getElementById("viewId").innerHTML =
                    this.dataset.id;

                document.getElementById("viewName").innerHTML =
                    this.dataset.name;

                document.getElementById("viewEmail").innerHTML =
                    this.dataset.email;

                document.getElementById("viewPhone").innerHTML =
                    this.dataset.phone;

                document.getElementById("viewGender").innerHTML =
                    this.dataset.gender;

                document.getElementById("viewDepartment").innerHTML =
                    this.dataset.department;

                document.getElementById("viewCourse").innerHTML =
                    this.dataset.course;

                document.getElementById("viewStatus").innerHTML =
                    this.dataset.status;

                document.getElementById("viewAdmission").innerHTML =
                    this.dataset.admission;

            });

        });
        
        var deleteModal = document.getElementById('deleteModal');

        deleteModal.addEventListener('show.bs.modal', function (event) {

            var button = event.relatedTarget;

            document.getElementById('StudentId').value =
                button.getAttribute('data-id');
        });


    </script>

}
<style>

    .detail-box {
        background: #F8F5FF;
        border-left: 4px solid #7C3AED;
        border-radius: 12px;
        padding: 14px 18px;
        font-weight: 600;
        color: #374151;
        min-height: 52px;
        display: flex;
        align-items: center;
    }

    .modal-content {
        border-radius: 22px;
    }

    .modal-header {
        border: none;
    }

    .modal-footer {
        border: none;
    }

    .viewStudent {
        transition: .3s;
    }

        .viewStudent:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 18px rgba(124,58,237,.25);
        }

</style>
