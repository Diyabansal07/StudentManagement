@model FinalProject.Models.Course

@{
    Layout = "~/Views/Shared/MyLayout.cshtml";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card shadow border-0 rounded-4">

                <div class="card-header bg-danger text-white">

                    <h4 class="mb-0">

                        <i class="bi bi-trash3-fill me-2"></i>

                        Delete Course

                    </h4>

                </div>

                <div class="card-body">

                    <div class="alert alert-warning">

                        <strong>

                            Are you sure you want to delete this course?

                        </strong>

                        <br />

                        This action cannot be undone.

                    </div>

                    <dl class="row">

                        <dt class="col-sm-4">

                            Course Code

                        </dt>

                        <dd class="col-sm-8">

                            @Model.CourseCode

                        </dd>

                        <dt class="col-sm-4">

                            Course Name

                        </dt>

                        <dd class="col-sm-8">

                            @Model.CourseName

                        </dd>

                        <dt class="col-sm-4">

                            Department

                        </dt>

                        <dd class="col-sm-8">

                            @Model.Department

                        </dd>

                        <dt class="col-sm-4">

                            Duration

                        </dt>

                        <dd class="col-sm-8">

                            @Model.DurationYears Years

                        </dd>

                    </dl>

                </div>

                <div class="card-footer text-end">

                    <form asp-action="Delete">

                        <input asp-for="CourseId" hidden />

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">

                            Cancel

                        </a>

                        <button class="btn btn-danger">

                            Delete Course

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>