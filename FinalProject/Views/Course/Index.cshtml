@model IEnumerable<Course>

@{
    Layout = "~/Views/Shared/MyLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap course-card-header">
        <div>
            <h2 class="text-purple fw-bold mb-1">
                <i class="bi bi-journal-bookmark-fill me-2"></i>
                Course Management
            </h2>

            <p class="text-muted mb-0">
                Manage all courses offered by EduNova.
            </p>
        </div>

        <a asp-controller="Course"
           asp-action="Upsert"
           class="btn btn-purple add-course-btn">

            <i class="bi bi-plus-circle me-2"></i>
            Add Course

        </a>

    </div>



    <!-- Success Message -->
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["success"]

            <button class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }



    <!-- Card -->

    <div class="card shadow mt-3">

        <div class="card-header card-header-purple py-3">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <!-- Left Heading -->
                <h5 class="text-white fw-semibold mb-0">
                    <i class="bi bi-list-ul me-2"></i>
                    Course List
                </h5>

                <!-- Right Side -->
                <div class="d-flex flex-column flex-md-row align-items-stretch align-items-md-center gap-2 w-100 w-md-auto">

                    <!-- Search -->
                    <div class="position-relative search-box">

                        <i class="bi bi-search position-absolute"
                           style="left:15px; top:50%; transform:translateY(-50%); color:#6c757d; z-index:5;"></i>

                        <input type="search"
                               id="searchCourse"
                               class="form-control rounded-pill ps-5"
                               placeholder="Search Course..." />

                    </div>

                    <!-- Filter Button -->
                    <div class="dropdown">

                        <button class="btn btn-light rounded-pill px-3 w-100"
                                type="button"
                                data-bs-toggle="dropdown">

                            <i class="bi bi-funnel-fill me-1"></i>
                            Filter

                        </button>

                        <ul class="dropdown-menu dropdown-menu-end shadow">

                            <li>
                                <a class="dropdown-item filter-option active"
                                   href="#"
                                   data-status="All">

                                    <i class="bi bi-list me-2"></i>
                                    All Status

                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item filter-option"
                                   href="#"
                                   data-status="Active">

                                    <i class="bi bi-check-circle-fill text-success me-2"></i>
                                    Active

                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item filter-option"
                                   href="#"
                                   data-status="Inactive">

                                    <i class="bi bi-x-circle-fill text-danger me-2"></i>
                                    Inactive

                                </a>
                            </li>

                        </ul>

                    </div>

                </div>

            </div>

        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle"
                       id="courseTable">

                    <thead>

                        <tr>

                            <th>Code</th>

                            <th>Course Name</th>

                            <th>Department</th>

                            <th>Duration</th>

                            <th>Semesters</th>

                            <th>Status</th>

                            <th width="170">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>

                                    <strong>

                                        @item.CourseCode

                                    </strong>

                                </td>

                                <td>

                                    @item.CourseName

                                </td>

                                <td>

                                    @item.Department

                                </td>

                                <td>

                                    @item.DurationYears Years

                                </td>

                                <td>

                                    @item.TotalSemesters

                                </td>

                                <td>

                                    @if (item.Status == "Active")
                                    {
                                        <span class="badge bg-success">

                                            Active

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">

                                            Inactive

                                        </span>
                                    }

                                </td>

                                <td>

                                    <!-- View -->

                                    <button type="button"
                                            class="btn btn-sm btn-outline-info viewCourse"
                                            data-bs-toggle="modal"
                                            data-bs-target="#viewCourseModal"
                                            data-id="@item.CourseId"
                                            data-code="@item.CourseCode"
                                            data-name="@item.CourseName"
                                            data-department="@item.Department"
                                            data-duration="@item.DurationYears Years"
                                            data-semesters="@item.TotalSemesters"
                                            data-status="@item.Status">

                                        <i class="bi bi-eye-fill"></i>

                                    </button>

                                    <!-- Edit -->

                                    <a asp-action="Upsert"
                                       asp-route-id="@item.CourseId"
                                       class="btn btn-sm btn-outline-primary">

                                        <i class="bi bi-pencil-square"></i>

                                    </a>

                                    <!-- Delete -->

                                    <a href="#"
                                       class="btn btn-sm btn-outline-danger"
                                       data-bs-toggle="modal"
                                       data-bs-target="#deleteModal"
                                       data-id="@item.CourseId">

                                        <i class="bi bi-trash"></i>

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
<div class="modal fade"
     id="viewCourseModal"
     tabindex="-1">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content border-0 shadow-lg">

            <div class="modal-header"
                 style="background:linear-gradient(135deg,#6D28D9,#8B5CF6);color:white;">

                <h5 class="modal-title">

                    <i class="bi bi-journal-bookmark-fill me-2"></i>

                    Course Details

                </h5>

                <button class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body p-4">

                <div class="row g-4">

                    <div class="col-md-6">

                        <label class="fw-bold text-muted">
                            Course ID
                        </label>

                        <div id="viewCourseId" class="detail-box"></div>

                    </div>

                    <div class="col-md-6">

                        <label class="fw-bold text-muted">
                            Course Code
                        </label>

                        <div id="viewCourseCode" class="detail-box"></div>

                    </div>

                    <div class="col-md-6">

                        <label class="fw-bold text-muted">
                            Course Name
                        </label>

                        <div id="viewCourseName" class="detail-box"></div>

                    </div>

                    <div class="col-md-6">

                        <label class="fw-bold text-muted">
                            Department
                        </label>

                        <div id="viewDepartment" class="detail-box"></div>

                    </div>

                    <div class="col-md-6">

                        <label class="fw-bold text-muted">
                            Duration
                        </label>

                        <div id="viewDuration" class="detail-box"></div>

                    </div>

                    <div class="col-md-6">

                        <label class="fw-bold text-muted">
                            Total Semesters
                        </label>

                        <div id="viewSemester" class="detail-box"></div>

                    </div>

                    <div class="col-md-12">

                        <label class="fw-bold text-muted">
                            Status
                        </label>

                        <div id="viewStatus" class="detail-box"></div>

                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button class="btn btn-purple"
                        data-bs-dismiss="modal">

                    Close

                </button>

            </div>

        </div>

    </div>

</div>
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <form asp-action="Delete" method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">Delete Course</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <input type="hidden" id="CourseId" name="CourseId" />

                    <p>Are you sure you want to delete this Course?</p>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-danger">
                        Delete
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {

    <script>

        const searchInput = document.getElementById("searchCourse");

        let selectedStatus = "All";

        function filterTable() {

            const search = searchInput.value.toLowerCase();

            const rows = document.querySelectorAll("#courseTable tbody tr");

            rows.forEach(function (row) {

                const rowText = row.innerText.toLowerCase();

                const rowStatus = row.cells[5].innerText.trim();

                const searchMatch = rowText.includes(search);

                const statusMatch =
                    selectedStatus === "All" ||
                    rowStatus === selectedStatus;

                row.style.display = (searchMatch && statusMatch)
                    ? ""
                    : "none";

            });

        }

        searchInput.addEventListener("keyup", filterTable);

        document.querySelectorAll(".filter-option").forEach(function(item){

            item.addEventListener("click",function(e){

                e.preventDefault();

                selectedStatus=this.dataset.status;

                document.querySelectorAll(".filter-option")
                .forEach(x=>x.classList.remove("active"));

                this.classList.add("active");

                filterTable();

            });

        });
                document.querySelectorAll(".viewCourse").forEach(function (btn) {

            btn.addEventListener("click", function () {

                document.getElementById("viewCourseId").textContent =
                    this.dataset.id;

                document.getElementById("viewCourseCode").textContent =
                    this.dataset.code;

                document.getElementById("viewCourseName").textContent =
                    this.dataset.name;

                document.getElementById("viewDepartment").textContent =
                    this.dataset.department;

                document.getElementById("viewDuration").textContent =
                    this.dataset.duration;

                document.getElementById("viewSemester").textContent =
                    this.dataset.semesters;

                document.getElementById("viewStatus").textContent =
                    this.dataset.status;

            });

        });
             var deleteModal = document.getElementById('deleteModal');

        deleteModal.addEventListener('show.bs.modal', function (event) {

            var button = event.relatedTarget;

            document.getElementById('CourseId').value = button.getAttribute('data-id');

        });

    </script>

}
<style>
    .detail-box {
        background: #F8F5FF;
        border-left: 4px solid #7C3AED;
        border-radius: 12px;
        padding: 14px 18px;
        font-weight: 600;
        color: #374151;
        min-height: 52px;
        display: flex;
        align-items: center;
    }

    .modal-content {
        border-radius: 22px;
    }

    .modal-header,
    .modal-footer {
        border: none;
    }

    .viewCourse {
        transition: .3s;
    }

        .viewCourse:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 18px rgba(124,58,237,.25);
        }

    /* ---------- Desktop ---------- */

    .search-box {
        width: 340px;
    }

    .add-course-btn {
        width: auto;
    }

    .course-card-header {
        flex-direction: row;
    }

    .action-buttons {
        display: flex;
        gap: 6px;
    }

        .action-buttons .btn {
            margin: 2px;
        }

    /* ---------- Tablet ---------- */

    @@media (max-width:991.98px) {

        .search-box {
            width: 100%;
            max-width: 100%;
        }

        .course-card-header {
            flex-direction: column;
            align-items: stretch !important;
            gap: 15px;
        }

        .card-header h5 {
            text-align: center;
            margin-bottom: 8px;
        }

        .table-responsive::-webkit-scrollbar {
            height: 4px;
        }

        .table-responsive::-webkit-scrollbar-thumb {
            background: #c9c9c9;
            border-radius: 10px;
        }

        .modal-dialog {
            margin: 1rem;
        }

        .app-main {
            min-height: calc(100vh - 120px);
        }
    }

    /* ---------- Mobile ---------- */

    @@media (max-width:767.98px) {

        h2 {
            font-size: 26px;
        }

        .add-course-btn {
            width: 100%;
        }

        .table th,
        .table td {
            white-space: nowrap;
            font-size: 14px;
        }

        .action-buttons {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 6px;
        }

            .action-buttons .btn {
                width: 36px;
                height: 36px;
                padding: 0;
                display: inline-flex;
                justify-content: center;
                align-items: center;
            }

        .modal-dialog {
            margin: .6rem;
        }

        .detail-box {
            font-size: 14px;
            padding: 12px;
        }

        .card {
            border-radius: 18px;
        }

        .card-body {
            padding: 1rem;
        }

        .container-fluid {
            padding-left: 12px;
            padding-right: 12px;
        }
    }
</style>