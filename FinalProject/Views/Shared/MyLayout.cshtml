<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />
    <meta name="description"
          content="EduNova Student Management System" />
    <meta name="author"content="Diya Bansal" />

    <title>@ViewData["Title"] - EduNova</title>

    <!-- ===========================
         Fonts
    ============================ -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/@@fontsource/source-sans-3@5.0.12/index.css" />
    <!-- ===========================
         Bootstrap Icons
    ============================ -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />

    <!-- ===========================
         Overlay Scrollbars
    ============================ -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.11.0/styles/overlayscrollbars.min.css" />
    <!-- ===========================
         AdminLTE CSS
    ============================ -->

    <link rel="stylesheet"
          href="~/assets/css/adminlte.css"
          asp-append-version="true" />
    <!-- ===========================
         EduNova Theme
    ============================ -->

    <link rel="stylesheet"
          href="~/css/theme.css"
          asp-append-version="true" />
    <!-- ===========================
         Apex Charts
    ============================ -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/apexcharts@3.37.1/dist/apexcharts.css" />



    <!-- ===========================
         JS Vector Map
    ============================ -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/jsvectormap@1.5.3/dist/css/jsvectormap.min.css" />

</head>
<body>
    <div class="app-wrapper">
        <nav class="app-header navbar navbar-expand bg-white shadow-sm">

    <div class="container-fluid">

        <!-- LEFT SIDE -->

        <ul class="navbar-nav">

            <!-- Sidebar Toggle -->

            <li class="nav-item">

                <a class="nav-link"
                   data-lte-toggle="sidebar"
                   href="#"
                   role="button">

                    <i class="bi bi-list fs-4 text-purple"></i>

                </a>

            </li>

        </ul>



        <!-- RIGHT SIDE -->

        <ul class="navbar-nav ms-auto align-items-center">

            <!-- Search -->

            <li class="nav-item">

                <a class="nav-link"
                   data-widget="navbar-search"
                   href="#">

                    <i class="bi bi-search fs-5 text-purple"></i>

                </a>

            </li>



            <!-- Fullscreen -->

            <li class="nav-item">

                <a class="nav-link"
                   href="#"
                   data-lte-toggle="fullscreen">

                    <i data-lte-icon="maximize"
                       class="bi bi-arrows-fullscreen text-purple"></i>

                    <i data-lte-icon="minimize"
                       class="bi bi-fullscreen-exit d-none text-purple"></i>

                </a>

            </li>



            <!-- User -->

            <li class="nav-item dropdown">

                <a class="nav-link d-flex align-items-center"
                   href="#"
                   data-bs-toggle="dropdown">

                    <img src="~/images/logo.png"
                         class="rounded-circle shadow me-2"
                         width="40"
                         height="40"
                         alt="EduNova">

                    <span class="fw-semibold text-dark">

                        @(User.Identity?.IsAuthenticated == true
                            ? User.Identity.Name
                            : "Administrator")

                    </span>

                    <i class="bi bi-chevron-down ms-2"></i>

                </a>



                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">

                    <li>

                        <h6 class="dropdown-header">

                            EduNova

                        </h6>

                    </li>

                    <li>
                        <hr class="dropdown-divider">
                    </li>

                    <li>

                        <a class="dropdown-item"
                           href="#">

                            <i class="bi bi-person-circle me-2"></i>

                            My Profile

                        </a>

                    </li>

                    <li>

                        <a asp-controller="Settings"
                            asp-action="Index"
                              class="nav-link">

                          <i class="bi bi-gear-fill"></i>

                              <span>Settings</span>

                        </a>

                    </li>

                    <li>
                        <hr class="dropdown-divider">
                    </li>

                    <li>

                        <form asp-area="Identity"
                              asp-page="/Account/Logout"
                              method="post">

                            <button type="submit"
                                    class="dropdown-item text-danger">

                                <i class="bi bi-box-arrow-right me-2"></i>

                                Logout

                            </button>

                        </form>

                    </li>

                </ul>

            </li>

        </ul>

    </div>

</nav>
<aside class="app-sidebar sidebar-purple shadow" data-bs-theme="dark">

    <!-- =========================
            BRAND LOGO
    ========================== -->

    <div class="sidebar-brand">

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="brand-link">

            <img src="~/images/logo.png"
                 alt="EduNova Logo"
                 class="brand-image shadow rounded-circle" />

            <span class="brand-text fw-bold fs-5">

                EduNova

            </span>

        </a>

    </div>



    <!-- =========================
            SIDEBAR MENU
    ========================== -->

    <div class="sidebar-wrapper">

        <nav class="mt-2">

            <ul class="nav sidebar-menu flex-column"
                data-lte-toggle="treeview"
                data-accordion="false">




                <!-- Dashboard -->

                <li class="nav-item">

                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="nav-link">

                        <i class="nav-icon bi bi-speedometer2"></i>

                        <p>

                            Dashboard

                        </p>

                    </a>

                </li>




                <!-- Students -->

                <li class="nav-item">

                    <a asp-controller="Student"
                       asp-action="Index"
                       class="nav-link">

                        <i class="nav-icon bi bi-mortarboard-fill"></i>

                        <p>

                            Students

                        </p>

                    </a>

                </li>

                <li class="nav-item">

                  <a asp-controller="Course"  asp-action="Index" class="nav-link">
                    <i class="nav-icon bi bi-journal-bookmark-fill"></i>

                      <p>Courses </p>
                  </a>

               </li>
            
                <!-- Settings -->

                <li class="nav-item">

                    <a asp-controller="Settings"  asp-action="Index"
                       class="nav-link">

                        <i class="nav-icon bi bi-gear-fill"></i>

                        <p>

                            Settings

                        </p>

                    </a>

                </li>




                <!-- Logout -->

                <li class="nav-item mt-3">

                    <form asp-area="Identity"
                          asp-page="/Account/Logout"
                          method="post">

                        <button type="submit"
                                class="nav-link border-0 bg-transparent w-100 text-start">

                            <i class="nav-icon bi bi-box-arrow-right"></i>

                            <p>

                                Logout

                            </p>

                        </button>

                    </form>

                </li>

            </ul>

        </nav>

    </div>

</aside>
<!-- ===============================
        MAIN CONTENT
================================ -->

<main class="app-main">

    <div class="app-content">

        <div class="container-fluid py-4">

            @RenderBody()

        </div>

    </div>

</main>



<!-- ===============================
        FOOTER
================================ -->

<footer class="app-footer border-top bg-white">

    <div class="float-end d-none d-sm-inline">

        Version 1.0.0

    </div>

    <strong>

        © @DateTime.Now.Year

        <span class="text-purple">

            EduNova Student Management System

        </span>

    </strong>

    |

    Developed by

    <strong>

        Diya Bansal

    </strong>

</footer>

</div>

    </div>
</body>



<!-- ===================================
        REQUIRED JAVASCRIPT FILES
==================================== -->

<!-- jQuery -->

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<!-- Bootstrap -->

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<!-- Overlay Scrollbars -->

<script src="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.11.0/browser/overlayscrollbars.browser.es6.min.js"></script>

<!-- AdminLTE -->

<script src="~/assets/js/adminlte.js"
        asp-append-version="true"></script>

<!-- Apex Charts -->

<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>

<!-- JS Vector Map -->

<script src="https://cdn.jsdelivr.net/npm/jsvectormap"></script>

<script src="https://cdn.jsdelivr.net/npm/jsvectormap/dist/maps/world.js"></script>

<!-- Site JS -->

<script src="~/js/site.js"
        asp-append-version="true"></script>

<!-- Validation / Page Scripts -->

@await RenderSectionAsync("Scripts", required: false)


</html>